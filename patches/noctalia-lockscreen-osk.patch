index 0000000000..513f384a1d
--- /dev/null
+++ b/src/shell/lockscreen/lockscreen_keyboard.cpp
@@ -0,0 +1,231 @@
+#include "shell/lockscreen/lockscreen_keyboard.h"
+
+#include "render/scene/input_area.h"
+#include "render/scene/node.h"
+#include "ui/builders.h"
+#include "ui/controls/button.h"
+#include "ui/controls/flex.h"
+#include "ui/controls/glyph.h"
+#include "ui/palette.h"
+#include "ui/style.h"
+
+#include <algorithm>
+#include <cmath>
+#include <string>
+
+namespace {
+
+  using lockscreen_keyboard::KeyAction;
+  using lockscreen_keyboard::KeyCap;
+  using lockscreen_keyboard::Layer;
+
+  constexpr float kKeyGap = Style::spaceXs + 2.0F;
+  constexpr float kPanelPadding = Style::spaceSm;
+  constexpr float kRowUnits = 10.0F;
+  constexpr float kMinKeyHeight = 40.0F;
+  constexpr float kMaxKeyHeight = 58.0F;
+
+  ButtonVariant variantFor(KeyAction action) {
+    switch (action) {
+    case KeyAction::Character:
+    case KeyAction::Space:
+      return ButtonVariant::Default;
+    case KeyAction::Enter:
+      return ButtonVariant::Primary;
+    default:
+      return ButtonVariant::Secondary;
+    }
+  }
+
+  float keyUnitWidth(float panelWidth) {
+    const float inner = std::max(0.0F, panelWidth - kPanelPadding * 2.0F);
+    return std::max(0.0F, (inner - kKeyGap * (kRowUnits - 1.0F)) / kRowUnits);
+  }
+
+  float keyHeightFor(float panelWidth) {
+    // Keys stay roughly square on phones and get flatter on wide screens.
+    return std::clamp(std::round(keyUnitWidth(panelWidth) * 1.1F), kMinKeyHeight, kMaxKeyHeight);
+  }
+
+} // namespace
+
+std::unique_ptr<Flex> LockscreenKeyboard::build(KeyCallback onKey, std::function<void()> onHide) {
+  m_onKey = std::move(onKey);
+  m_onHide = std::move(onHide);
+  m_rows.clear();
+  m_keys.clear();
+  m_layer = Layer::Lower;
+
+  auto panel = ui::flex(
+      FlexDirection::Vertical,
+      {
+          .out = &m_panel,
+          .align = FlexAlign::Center,
+          .justify = FlexJustify::Start,
+          .gap = kKeyGap,
+          .padding = kPanelPadding,
+          .fill = colorSpecFromRole(ColorRole::SurfaceContainer, 0.94F),
+          .radius = Style::radiusXl,
+          .border = colorSpecFromRole(ColorRole::OutlineVariant),
+          .visible = false,
+      }
+  );
+
+  const auto& rows = lockscreen_keyboard::rowsFor(m_layer);
+  for (std::size_t r = 0; r < rows.size(); ++r) {
+    Flex* rowFlex = nullptr;
+    panel->addChild(
+        ui::flex(
+            FlexDirection::Horizontal,
+            {
+                .out = &rowFlex,
+                .align = FlexAlign::Center,
+                .justify = FlexJustify::Center,
+                .gap = kKeyGap,
+                .widthPolicy = FlexSizePolicy::Fill,
+                .heightPolicy = FlexSizePolicy::Content,
+            }
+        )
+    );
+    m_rows.push_back(rowFlex);
+
+    for (std::size_t i = 0; i < rows[r].size(); ++i) {
+      const KeyCap& key = rows[r][i];
+      Button* button = nullptr;
+      rowFlex->addChild(
+          ui::button({
+              .out = &button,
+              .text = "",
+              .variant = variantFor(key.action),
+              .onClick = [this, r, i] { handlePress(r, i); },
+              .configure =
+                  [](Button& b) {
+                    // Keys must never take focus: a press would blur the password field (dropping its
+                    // text-input state), so the next physical key after hiding the keyboard is lost.
+                    b.setTabStop(false);
+                    if (InputArea* area = b.inputArea(); area != nullptr) {
+                      area->setFocusable(false);
+                    }
+                  },
+          })
+      );
+      m_keys.push_back(KeySlot{.button = button, .row = r, .index = i});
+    }
+  }
+
+  applyLayer();
+  return panel;
+}
+
+float LockscreenKeyboard::preferredHeight(float width) noexcept {
+  const auto rows = static_cast<float>(lockscreen_keyboard::kRowCount);
+  return keyHeightFor(width) * rows + kKeyGap * (rows - 1.0F) + kPanelPadding * 2.0F;
+}
+
+void LockscreenKeyboard::setVisible(bool visible) {
+  m_visible = visible;
+  if (m_panel != nullptr) {
+    m_panel->setVisible(visible);
+  }
+}
+
+void LockscreenKeyboard::setRadius(float panelRadius, float keyRadius) {
+  m_keyRadius = keyRadius;
+  if (m_panel != nullptr) {
+    m_panel->setRadius(panelRadius);
+  }
+}
+
+void LockscreenKeyboard::reset() {
+  if (m_layer != Layer::Lower) {
+    m_layer = Layer::Lower;
+    applyLayer();
+  }
+}
+
+void LockscreenKeyboard::handlePress(std::size_t row, std::size_t index) {
+  const auto& rows = lockscreen_keyboard::rowsFor(m_layer);
+  if (row >= rows.size() || index >= rows[row].size()) {
+    return;
+  }
+  const KeyCap key = rows[row][index];
+
+  if (key.action == KeyAction::Hide) {
+    if (m_onHide) {
+      m_onHide();
+    }
+    return;
+  }
+
+  if (const auto output = lockscreen_keyboard::outputFor(key); output.has_value() && m_onKey) {
+    m_onKey(*output);
+  }
+
+  const Layer next = lockscreen_keyboard::nextLayer(m_layer, key.action);
+  if (next != m_layer) {
+    m_layer = next;
+    applyLayer();
+  }
+}
+
+void LockscreenKeyboard::applyLayer() {
+  const auto& rows = lockscreen_keyboard::rowsFor(m_layer);
+  for (const KeySlot& slot : m_keys) {
+    if (slot.button == nullptr || slot.row >= rows.size() || slot.index >= rows[slot.row].size()) {
+      continue;
+    }
+    const KeyCap& key = rows[slot.row][slot.index];
+    if (key.action == KeyAction::Character) {
+      // Character slots never carry a glyph (Button would otherwise draw a placeholder icon).
+      slot.button->setText(key.text);
+      continue;
+    }
+    const std::string_view glyph = lockscreen_keyboard::specialGlyph(key.action, m_layer);
+    slot.button->setText(lockscreen_keyboard::specialLabel(key.action, m_layer));
+    if (!glyph.empty()) {
+      slot.button->setGlyph(glyph);
+    }
+    // Button hides an empty label itself but never its glyph.
+    if (auto* glyphNode = slot.button->glyph(); glyphNode != nullptr) {
+      glyphNode->setVisible(!glyph.empty());
+    }
+  }
+}
+
+void LockscreenKeyboard::arrange(Renderer& renderer, const LayoutRect& rect) {
+  if (m_panel == nullptr) {
+    return;
+  }
+  const float unit = keyUnitWidth(rect.width);
+  const float keyHeight = keyHeightFor(rect.width);
+  const float fontSize = std::clamp(std::round(keyHeight * 0.38F), Style::fontSizeBody, Style::fontSizeHeader);
+  const float glyphSize = std::round(fontSize * 1.1F);
+
+  const auto& rows = lockscreen_keyboard::rowsFor(m_layer);
+  for (const KeySlot& slot : m_keys) {
+    if (slot.button == nullptr || slot.row >= rows.size() || slot.index >= rows[slot.row].size()) {
+      continue;
+    }
+    const float units = rows[slot.row][slot.index].width;
+    const float keyWidth = std::floor(unit * units + kKeyGap * (units - 1.0F));
+    // An explicit size counts as an assigned box for Button, which otherwise squares glyph-only keys
+    // (Shift, Backspace) to their width whenever they are re-laid out after a relabel.
+    slot.button->setSize(keyWidth, keyHeight);
+    slot.button->setMinWidth(keyWidth);
+    slot.button->setMaxWidth(keyWidth);
+    slot.button->setMinHeight(keyHeight);
+    slot.button->setMaxHeight(keyHeight);
+    slot.button->setControlHeight(keyHeight);
+    slot.button->setFontSize(fontSize);
+    if (slot.button->glyph() != nullptr) {
+      slot.button->setGlyphSize(glyphSize);
+    }
+    slot.button->setRadius(m_keyRadius);
+  }
+
+  m_panel->setMinWidth(rect.width);
+  m_panel->setMaxWidth(rect.width);
+  m_panel->setMinHeight(rect.height);
+  m_panel->setMaxHeight(rect.height);
+  m_panel->arrange(renderer, rect);
+}
diff --git a/src/shell/lockscreen/lockscreen_keyboard.h b/src/shell/lockscreen/lockscreen_keyboard.h
new file mode 100644
index 0000000000..72116cf129
--- /dev/null
+++ b/src/shell/lockscreen/lockscreen_keyboard.h
@@ -0,0 +1,56 @@
+#pragma once
+
+#include "shell/lockscreen/lockscreen_keyboard_layout.h"
+
+#include <functional>
+#include <memory>
+#include <vector>
+
+class Button;
+class Flex;
+class Renderer;
+struct LayoutRect;
+
+// On-screen keyboard drawn on the lock surface. The session lock hides every other client's
+// surfaces, so an external OSK cannot appear here; this one is plain noctalia controls and feeds
+// synthesized key events back to its owner.
+class LockscreenKeyboard {
+public:
+  using KeyCallback = std::function<void(const lockscreen_keyboard::KeyOutput&)>;
+
+  LockscreenKeyboard() = default;
+  LockscreenKeyboard(const LockscreenKeyboard&) = delete;
+  LockscreenKeyboard& operator=(const LockscreenKeyboard&) = delete;
+
+  // Builds the keyboard panel. The caller adds the returned node to its scene and keeps it alive at
+  // least as long as this object is used.
+  [[nodiscard]] std::unique_ptr<Flex> build(KeyCallback onKey, std::function<void()> onHide);
+
+  // Preferred height for a given panel width.
+  [[nodiscard]] static float preferredHeight(float width) noexcept;
+
+  void setVisible(bool visible);
+  [[nodiscard]] bool visible() const noexcept { return m_visible; }
+  void setRadius(float panelRadius, float keyRadius);
+  void reset(); // back to the lowercase layer
+  void arrange(Renderer& renderer, const LayoutRect& rect);
+
+private:
+  struct KeySlot {
+    Button* button = nullptr;
+    std::size_t row = 0;
+    std::size_t index = 0;
+  };
+
+  void handlePress(std::size_t row, std::size_t index);
+  void applyLayer();
+
+  Flex* m_panel = nullptr;
+  std::vector<Flex*> m_rows;
+  std::vector<KeySlot> m_keys;
+  lockscreen_keyboard::Layer m_layer = lockscreen_keyboard::Layer::Lower;
+  KeyCallback m_onKey;
+  std::function<void()> m_onHide;
+  float m_keyRadius = 6.0F;
+  bool m_visible = false;
+};
diff --git a/src/shell/lockscreen/lockscreen_keyboard_layout.cpp b/src/shell/lockscreen/lockscreen_keyboard_layout.cpp
new file mode 100644
index 0000000000..26f485a1bf
--- /dev/null
+++ b/src/shell/lockscreen/lockscreen_keyboard_layout.cpp
@@ -0,0 +1,212 @@
+#include "shell/lockscreen/lockscreen_keyboard_layout.h"
+
+#include <xkbcommon/xkbcommon-keysyms.h>
+#include <xkbcommon/xkbcommon.h>
+
+namespace lockscreen_keyboard {
+
+  namespace {
+
+    constexpr KeyCap ch(std::string_view text) { return KeyCap{.action = KeyAction::Character, .text = text}; }
+    constexpr KeyCap special(KeyAction action, float width) { return KeyCap{.action = action, .width = width}; }
+
+    // Shared bottom row: [hide] [layer] [space] [.] [enter]
+    constexpr std::array kBottomRow = {
+        special(KeyAction::Hide, 1.0F),  special(KeyAction::LayerToggle, 1.5F),
+        special(KeyAction::Space, 5.0F), ch("."),
+        special(KeyAction::Enter, 1.5F),
+    };
+
+    constexpr std::array kLowerRow0 = {ch("q"), ch("w"), ch("e"), ch("r"), ch("t"),
+                                       ch("y"), ch("u"), ch("i"), ch("o"), ch("p")};
+    constexpr std::array kLowerRow1 = {ch("a"), ch("s"), ch("d"), ch("f"), ch("g"), ch("h"), ch("j"), ch("k"), ch("l")};
+    constexpr std::array kLowerRow2 = {
+        special(KeyAction::Shift, 1.5F),     ch("z"), ch("x"), ch("c"), ch("v"), ch("b"), ch("n"), ch("m"),
+        special(KeyAction::Backspace, 1.5F),
+    };
+
+    constexpr std::array kUpperRow0 = {ch("Q"), ch("W"), ch("E"), ch("R"), ch("T"),
+                                       ch("Y"), ch("U"), ch("I"), ch("O"), ch("P")};
+    constexpr std::array kUpperRow1 = {ch("A"), ch("S"), ch("D"), ch("F"), ch("G"), ch("H"), ch("J"), ch("K"), ch("L")};
+    constexpr std::array kUpperRow2 = {
+        special(KeyAction::Shift, 1.5F),     ch("Z"), ch("X"), ch("C"), ch("V"), ch("B"), ch("N"), ch("M"),
+        special(KeyAction::Backspace, 1.5F),
+    };
+
+    constexpr std::array kSymbolsRow0 = {ch("1"), ch("2"), ch("3"), ch("4"), ch("5"),
+                                         ch("6"), ch("7"), ch("8"), ch("9"), ch("0")};
+    constexpr std::array kSymbolsRow1 = {ch("@"), ch("#"), ch("$"), ch("%"), ch("&"),
+                                         ch("-"), ch("+"), ch("("), ch(")")};
+    constexpr std::array kSymbolsRow2 = {
+        special(KeyAction::Shift, 1.5F),     ch("*"), ch("\""), ch("'"), ch(":"), ch(";"), ch("!"), ch("?"),
+        special(KeyAction::Backspace, 1.5F),
+    };
+
+    constexpr std::array kSymbolsAltRow0 = {ch("~"), ch("`"), ch("|"), ch("\\"), ch("/"),
+                                            ch("_"), ch("="), ch("^"), ch("["),  ch("]")};
+    constexpr std::array kSymbolsAltRow1 = {ch("{"), ch("}"), ch("<"), ch(">"), ch(","),
+                                            ch("€"), ch("£"), ch("¥"), ch("°")};
+    constexpr std::array kSymbolsAltRow2 = {
+        special(KeyAction::Shift, 1.5F),     ch("§"), ch("¢"), ch("×"), ch("÷"), ch("¿"), ch("¡"), ch("•"),
+        special(KeyAction::Backspace, 1.5F),
+    };
+
+    const LayerRows kLowerRows = {kLowerRow0, kLowerRow1, kLowerRow2, kBottomRow};
+    const LayerRows kUpperRows = {kUpperRow0, kUpperRow1, kUpperRow2, kBottomRow};
+    const LayerRows kSymbolsRows = {kSymbolsRow0, kSymbolsRow1, kSymbolsRow2, kBottomRow};
+    const LayerRows kSymbolsAltRows = {kSymbolsAltRow0, kSymbolsAltRow1, kSymbolsAltRow2, kBottomRow};
+
+    // Decodes the first UTF-8 codepoint of `text`; 0 for empty or malformed input.
+    std::uint32_t firstCodepoint(std::string_view text) noexcept {
+      if (text.empty()) {
+        return 0;
+      }
+      const auto b0 = static_cast<unsigned char>(text[0]);
+      std::size_t length = 0;
+      std::uint32_t cp = 0;
+      if (b0 < 0x80U) {
+        return b0;
+      }
+      if ((b0 & 0xE0U) == 0xC0U) {
+        length = 2;
+        cp = b0 & 0x1FU;
+      } else if ((b0 & 0xF0U) == 0xE0U) {
+        length = 3;
+        cp = b0 & 0x0FU;
+      } else if ((b0 & 0xF8U) == 0xF0U) {
+        length = 4;
+        cp = b0 & 0x07U;
+      } else {
+        return 0;
+      }
+      if (text.size() < length) {
+        return 0;
+      }
+      for (std::size_t i = 1; i < length; ++i) {
+        const auto b = static_cast<unsigned char>(text[i]);
+        if ((b & 0xC0U) != 0x80U) {
+          return 0;
+        }
+        cp = (cp << 6U) | (b & 0x3FU);
+      }
+      return cp;
+    }
+
+    KeyOutput fromKeysym(std::uint32_t sym) noexcept {
+      // Match what a hardware key reports: xkb gives Return -> '\r' and BackSpace -> '\b'.
+      return KeyOutput{.sym = sym, .utf32 = xkb_keysym_to_utf32(sym)};
+    }
+
+  } // namespace
+
+  const LayerRows& rowsFor(Layer layer) noexcept {
+    switch (layer) {
+    case Layer::Lower:
+      return kLowerRows;
+    case Layer::Upper:
+      return kUpperRows;
+    case Layer::Symbols:
+      return kSymbolsRows;
+    case Layer::SymbolsAlt:
+      return kSymbolsAltRows;
+    }
+    return kLowerRows;
+  }
+
+  float rowInset(std::size_t row) noexcept { return row == 1 ? 0.5F : 0.0F; }
+
+  std::optional<KeyOutput> outputFor(const KeyCap& key) noexcept {
+    switch (key.action) {
+    case KeyAction::Character: {
+      const std::uint32_t cp = firstCodepoint(key.text);
+      if (cp == 0) {
+        return std::nullopt;
+      }
+      const xkb_keysym_t sym = xkb_utf32_to_keysym(cp);
+      if (sym == XKB_KEY_NoSymbol) {
+        return std::nullopt;
+      }
+      return KeyOutput{.sym = sym, .utf32 = cp};
+    }
+    case KeyAction::Backspace:
+      return fromKeysym(XKB_KEY_BackSpace);
+    case KeyAction::Enter:
+      return fromKeysym(XKB_KEY_Return);
+    case KeyAction::Space:
+      return fromKeysym(XKB_KEY_space);
+    case KeyAction::Shift:
+    case KeyAction::LayerToggle:
+    case KeyAction::Hide:
+      return std::nullopt;
+    }
+    return std::nullopt;
+  }
+
+  Layer nextLayer(Layer current, KeyAction action) noexcept {
+    switch (action) {
+    case KeyAction::Shift:
+      switch (current) {
+      case Layer::Lower:
+        return Layer::Upper;
+      case Layer::Upper:
+        return Layer::Lower;
+      case Layer::Symbols:
+        return Layer::SymbolsAlt;
+      case Layer::SymbolsAlt:
+        return Layer::Symbols;
+      }
+      return current;
+    case KeyAction::LayerToggle:
+      return (current == Layer::Lower || current == Layer::Upper) ? Layer::Symbols : Layer::Lower;
+    case KeyAction::Character:
+      return current == Layer::Upper ? Layer::Lower : current;
+    case KeyAction::Backspace:
+    case KeyAction::Enter:
+    case KeyAction::Space:
+    case KeyAction::Hide:
+      return current;
+    }
+    return current;
+  }
+
+  std::string_view specialLabel(KeyAction action, Layer layer) noexcept {
+    switch (action) {
+    case KeyAction::LayerToggle:
+      return (layer == Layer::Lower || layer == Layer::Upper) ? "?123" : "ABC";
+    case KeyAction::Shift:
+      if (layer == Layer::Symbols) {
+        return "=\\<";
+      }
+      if (layer == Layer::SymbolsAlt) {
+        return "?123";
+      }
+      return {};
+    default:
+      return {};
+    }
+  }
+
+  std::string_view specialGlyph(KeyAction action, Layer layer) noexcept {
+    switch (action) {
+    case KeyAction::Shift:
+      if (layer == Layer::Lower) {
+        return "arrow-big-up";
+      }
+      if (layer == Layer::Upper) {
+        return "arrow-big-up-filled";
+      }
+      return {};
+    case KeyAction::Backspace:
+      return "backspace";
+    case KeyAction::Enter:
+      return "corner-down-left";
+    case KeyAction::Space:
+      return "space";
+    case KeyAction::Hide:
+      return "keyboard-hide";
+    default:
+      return {};
+    }
+  }
+
+} // namespace lockscreen_keyboard
diff --git a/src/shell/lockscreen/lockscreen_keyboard_layout.h b/src/shell/lockscreen/lockscreen_keyboard_layout.h
new file mode 100644
index 0000000000..4feadee6d0
--- /dev/null
+++ b/src/shell/lockscreen/lockscreen_keyboard_layout.h
@@ -0,0 +1,67 @@
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <string_view>
+
+// Pure layout and keymap data for the lockscreen on-screen keyboard. Kept free of scene code so the
+// key -> keysym mapping and layer transitions are unit-testable.
+namespace lockscreen_keyboard {
+
+  enum class KeyAction : std::uint8_t {
+    Character,
+    Shift, // Lower <-> Upper; Symbols <-> SymbolsAlt
+    Backspace,
+    Enter,
+    Space,
+    LayerToggle, // letters <-> symbols
+    Hide,
+  };
+
+  enum class Layer : std::uint8_t {
+    Lower,
+    Upper,
+    Symbols,
+    SymbolsAlt,
+  };
+
+  struct KeyCap {
+    KeyAction action = KeyAction::Character;
+    // UTF-8 text for Character keys; empty for special keys (their label depends on the layer).
+    std::string_view text;
+    // Width in key units (1.0 is a regular letter key).
+    float width = 1.0F;
+  };
+
+  constexpr std::size_t kRowCount = 4;
+
+  // Every layer has the same number of keys per row and the same special keys at the same positions,
+  // so the UI can build its buttons once and only relabel them when the layer changes.
+  using LayerRows = std::array<std::span<const KeyCap>, kRowCount>;
+
+  [[nodiscard]] const LayerRows& rowsFor(Layer layer) noexcept;
+
+  // Indent, in key units, applied on both sides of a row (row 1 is offset by half a key).
+  [[nodiscard]] float rowInset(std::size_t row) noexcept;
+
+  struct KeyOutput {
+    std::uint32_t sym = 0;
+    std::uint32_t utf32 = 0;
+  };
+
+  // The keysym/codepoint pair a hardware keyboard would report for this key, or nullopt for keys
+  // that only change the keyboard's own state (Shift, LayerToggle, Hide).
+  [[nodiscard]] std::optional<KeyOutput> outputFor(const KeyCap& key) noexcept;
+
+  // The layer to show after `action` is pressed on `current`. Upper is one-shot: typing a character
+  // returns to Lower.
+  [[nodiscard]] Layer nextLayer(Layer current, KeyAction action) noexcept;
+
+  // Text label for special keys on `layer` (empty when the key shows a glyph instead).
+  [[nodiscard]] std::string_view specialLabel(KeyAction action, Layer layer) noexcept;
+  // Glyph name for special keys (empty when the key shows text).
+  [[nodiscard]] std::string_view specialGlyph(KeyAction action, Layer layer) noexcept;
+
+} // namespace lockscreen_keyboard
